#!/bin/sh
### BEGIN INIT INFO
# Provides:          minios-persistence-guard
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MiniOS persistence guard
# Description:       Monitors persistence backing storage and warns on low space.
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DAEMON=/usr/bin/minios-persistence-guard
NAME=minios-persistence-guard
PIDFILE=/run/minios-persistence-guard.pid

. /lib/lsb/init-functions 2>/dev/null || true

case "$1" in
    start)
        log_daemon_msg "Starting $NAME" 2>/dev/null || echo "Starting $NAME"
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON"
        ;;
    stop)
        log_daemon_msg "Stopping $NAME" 2>/dev/null || echo "Stopping $NAME"
        start-stop-daemon --stop --quiet --oknodo --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" 2>/dev/null || exit $?
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 3
        ;;
esac

exit 0
