#!/bin/sh
### BEGIN INIT INFO
# Provides:          minios-session-autosave
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Should-Start:      minios-persistence-guard
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MiniOS periodic SquashFS session save check
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
NAME=minios-session-autosave
COMMAND=${MINIOS_AUTOSAVE_COMMAND:-/usr/bin/minios-session}
PIDFILE=${MINIOS_AUTOSAVE_PIDFILE:-/run/minios-session-autosave.pid}
INTERVAL=${MINIOS_AUTOSAVE_POLL_SECONDS:-1800}

. /lib/lsb/init-functions 2>/dev/null || true

run_loop() {
    trap 'exit 0' HUP INT TERM
    while :; do
        sleep "$INTERVAL" &
        wait $! || exit 0
        "$COMMAND" autosave --json >/dev/null 2>&1 || true
    done
}

case "$1" in
    daemon)
        run_loop
        ;;
    start)
        [ -x "$COMMAND" ] || exit 0
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --startas "$0" -- daemon
        ;;
    stop)
        start-stop-daemon --stop --quiet --oknodo --retry=TERM/5/KILL/5 \
            --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        status_of_proc -p "$PIDFILE" "$0" "$NAME" 2>/dev/null || exit $?
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac

exit 0
