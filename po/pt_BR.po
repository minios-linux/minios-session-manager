#: lib/minios_session.py:2842
msgid "MiniOS Session Manager - Command line tool for managing persistent sessions"
msgstr "MiniOS Session Manager - Ferramenta de linha de comando para gerenciar sessões persistentes"

#: lib/minios_session.py:2844
msgid ""
"\n"
"GLOBAL OPTIONS:\n"
"  --json                    Output results in JSON format (can be used with any command)\n"
"  --sessions-dir PATH       Use custom sessions directory instead of default\n"
"\n"
"COMMANDS:\n"
"  list                      List all available sessions with detailed information\n"
"  active                    Show currently active session (will boot next)\n"
"  running                   Show currently running session (current boot)\n"
"  info                      Show filesystem type and compatible session modes\n"
"  activate SESSION_ID       Activate specified session\n"
"  create [MODE] [SIZE]      Create new session using positional arguments\n"
"  delete SESSION_ID         Delete specified session\n"
"  cleanup [--days N]        Delete old sessions (default: 30 days)\n"
"  status                    Check sessions directory status and permissions\n"
"  resize SESSION_ID SIZE    Grow a container session\n"
"  export SESSION_ID PATH    Export session to .tar.zst archive\n"
"  import ARCHIVE            Import session from .tar.zst archive\n"
"  copy SESSION_ID           Copy session (optional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Convert session to different mode (optional: --size)\n"
"\n"
"SESSION MODES:\n"
"  native                    Direct filesystem changes (requires POSIX-compatible filesystem)\n"
"  dynfilefs                 Dynamic file system overlay (works on any filesystem)\n"
"  raw                       Raw disk image (works on any filesystem, 4000MB default)\n"
"\n"
"COMMAND BEHAVIOR:\n"
"  • create without MODE: Uses native mode (may fail on FAT32/NTFS/exFAT)\n"
"  • create without SIZE: Uses 4000MB for container modes\n"
"  • convert replaces the source by default; --new-session preserves it\n"
"  • cleanup without --days: Uses 30-day threshold for deletion\n"
"  • cleanup protects both active and running sessions from deletion\n"
"\n"
"EXAMPLES:\n"
"\n"
"  Basic Usage:\n"
"    minios-session list                           List all available sessions\n"
"    minios-session active                         Show which session will boot next\n"
"    minios-session running                        Show currently running session\n"
"    minios-session info                           Show filesystem compatibility info\n"
"\n"
"  Session Management:\n"
"    minios-session activate 2                     Set session #2 as default for next boot\n"
"    minios-session delete 3                       Delete session #3 permanently\n"
"    minios-session cleanup --days 30              Delete sessions older than 30 days\n"
"    minios-session cleanup                        Delete sessions older than 30 days (default)\n"
"\n"
"  Creating Sessions:\n"
"    minios-session create                         Create native session (filesystem changes)\n"
"    minios-session create native                  Create native session explicitly\n"
"    minios-session create dynfilefs               Create 4000MB dynfilefs session (default size)\n"
"    minios-session create dynfilefs 8000          Create 8000MB dynfilefs session\n"
"    minios-session create raw 2000                Create 2000MB raw disk image\n"
"\n"
"  Session Operations:\n"
"    minios-session resize 2 4000                  Resize session #2 to 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Export session #3 to archive\n"
"    minios-session import /tmp/backup.tar.zst     Import session from archive\n"
"    minios-session copy 2                         Copy session #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Copy session #2 as raw with 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Convert session #3 to dynfilefs with 2000MB\n"
"\n"
"  Error Handling:\n"
"    minios-session create                         May fail on FAT32/NTFS/exFAT: \"Use dynfilefs or raw mode\"\n"
"    minios-session create raw 5000                Will fail on FAT32: MiniOS limits fixed containers to 4000MB\n"
"\n"
"  JSON Output (for automation):\n"
"    minios-session --json list                    List sessions in JSON format\n"
"    minios-session active --json                  Get active session info as JSON\n"
"    minios-session info --json                    Get system info as JSON\n"
"\n"
"  Custom Session Directory:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "
msgstr ""
"\n"
"OPÇÕES GLOBAIS:\n"
"  --json                    Exibe os resultados em formato JSON (pode ser usado com qualquer comando)\n"
"  --sessions-dir CAMINHO    Usa um diretório de sessões personalizado em vez do padrão\n"
"\n"
"COMANDOS:\n"
"  list                      Lista todas as sessões disponíveis com informações detalhadas\n"
"  active                    Mostra a sessão atualmente ativa (será iniciada no próximo boot)\n"
"  running                   Mostra a sessão em execução no momento (boot atual)\n"
"  info                      Exibe o tipo de sistema de arquivos e modos de sessão compatíveis\n"
"  activate SESSION_ID       Ativa a sessão especificada\n"
"  create [MODE] [SIZE]      Cria uma nova sessão usando argumentos posicionais\n"
"  delete SESSION_ID         Exclui a sessão especificada\n"
"  cleanup [--days N]        Remove sessões antigas (padrão: 30 dias)\n"
"  status                    Verifica o status e permissões do diretório de sessões\n"
"  resize SESSION_ID SIZE    Aumenta o tamanho de uma sessão em contêiner\n"
"  export SESSION_ID PATH    Exporta a sessão para um arquivo .tar.zst\n"
"  import ARCHIVE            Importa uma sessão de um arquivo .tar.zst\n"
"  copy SESSION_ID           Copia uma sessão (opcional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Converte a sessão para outro modo (opcional: --size)\n"
"\n"
"MODOS DE SESSÃO:\n"
"  native                    Alterações diretas no sistema de arquivos (requer sistema de arquivos compatível com POSIX)\n"
"  dynfilefs                 Overlay de sistema de arquivos dinâmico (funciona em qualquer sistema de arquivos)\n"
"  raw                       Imagem de disco bruta (funciona em qualquer sistema de arquivos, padrão de 4000MB)\n"
"\n"
"COMPORTAMENTO DOS COMANDOS:\n"
"  • create sem MODE: Usa o modo native (pode falhar em FAT32/NTFS/exFAT)\n"
"  • create sem SIZE: Usa 4000MB para modos em contêiner\n"
"  • convert substitui a origem por padrão; --new-session preserva a original\n"
"  • cleanup sem --days: Usa 30 dias como limite para exclusão\n"
"  • cleanup protege sessões ativas e em execução contra exclusão\n"
"\n"
"EXEMPLOS:\n"
"\n"
"  Uso Básico:\n"
"    minios-session list                           Lista todas as sessões disponíveis\n"
"    minios-session active                         Mostra qual sessão será iniciada no próximo boot\n"
"    minios-session running                        Mostra a sessão em execução\n"
"    minios-session info                           Exibe informações de compatibilidade do sistema de arquivos\n"
"\n"
"  Gerenciamento de Sessões:\n"
"    minios-session activate 2                     Define a sessão #2 como padrão para o próximo boot\n"
"    minios-session delete 3                       Exclui a sessão #3 permanentemente\n"
"    minios-session cleanup --days 30              Remove sessões com mais de 30 dias\n"
"    minios-session cleanup                        Remove sessões com mais de 30 dias (padrão)\n"
"\n"
"  Criação de Sessões:\n"
"    minios-session create                         Cria uma sessão native (alterações no sistema de arquivos)\n"
"    minios-session create native                  Cria explicitamente uma sessão native\n"
"    minios-session create dynfilefs               Cria uma sessão dynfilefs de 4000MB (tamanho padrão)\n"
"    minios-session create dynfilefs 8000          Cria uma sessão dynfilefs de 8000MB\n"
"    minios-session create raw 2000                Cria uma imagem de disco raw de 2000MB\n"
"\n"
"  Operações de Sessão:\n"
"    minios-session resize 2 4000                  Redimensiona a sessão #2 para 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Exporta a sessão #3 para um arquivo\n"
"    minios-session import /tmp/backup.tar.zst     Importa uma sessão de um arquivo\n"
"    minios-session copy 2                         Copia a sessão #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Copia a sessão #2 como raw com 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Converte a sessão #3 para dynfilefs com 2000MB\n"
"\n"
"  Tratamento de Erros:\n"
"    minios-session create                         Pode falhar em FAT32/NTFS/exFAT: \"Use o modo dynfilefs ou raw\"\n"
"    minios-session create raw 5000                Vai falhar em FAT32: O MiniOS limita contêineres fixos a 4000MB\n"
"\n"
"  Saída em JSON (para automação):\n"
"    minios-session --json list                    Lista sessões em formato JSON\n"
"    minios-session active --json                  Exibe informações da sessão ativa em JSON\n"
"    minios-session info --json                    Exibe informações do sistema em JSON\n"
"\n"
"  Diretório de Sessões Personalizado:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "

