#: lib/minios_session.py:2842
msgid "MiniOS Session Manager - Command line tool for managing persistent sessions"
msgstr "MiniOS-Sitzungsmanager - Kommandozeilen-Tool zur Verwaltung persistenter Sitzungen"

#: lib/minios_session.py:2844
msgid ""
"\n"
"GLOBAL OPTIONS:\n"
"  --json                    Output results in JSON format (can be used with any command)\n"
"  --sessions-dir PATH       Use custom sessions directory instead of default\n"
"\n"
"COMMANDS:\n"
"  list                      List all available sessions with detailed information\n"
"  active                    Show currently active session (will boot next)\n"
"  running                   Show currently running session (current boot)\n"
"  info                      Show filesystem type and compatible session modes\n"
"  activate SESSION_ID       Activate specified session\n"
"  create [MODE] [SIZE]      Create new session using positional arguments\n"
"  delete SESSION_ID         Delete specified session\n"
"  cleanup [--days N]        Delete old sessions (default: 30 days)\n"
"  status                    Check sessions directory status and permissions\n"
"  resize SESSION_ID SIZE    Grow a container session\n"
"  export SESSION_ID PATH    Export session to .tar.zst archive\n"
"  import ARCHIVE            Import session from .tar.zst archive\n"
"  copy SESSION_ID           Copy session (optional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Convert session to different mode (optional: --size)\n"
"\n"
"SESSION MODES:\n"
"  native                    Direct filesystem changes (requires POSIX-compatible filesystem)\n"
"  dynfilefs                 Dynamic file system overlay (works on any filesystem)\n"
"  raw                       Raw disk image (works on any filesystem, 4000MB default)\n"
"\n"
"COMMAND BEHAVIOR:\n"
"  • create without MODE: Uses native mode (may fail on FAT32/NTFS/exFAT)\n"
"  • create without SIZE: Uses 4000MB for container modes\n"
"  • convert replaces the source by default; --new-session preserves it\n"
"  • cleanup without --days: Uses 30-day threshold for deletion\n"
"  • cleanup protects both active and running sessions from deletion\n"
"\n"
"EXAMPLES:\n"
"\n"
"  Basic Usage:\n"
"    minios-session list                           List all available sessions\n"
"    minios-session active                         Show which session will boot next\n"
"    minios-session running                        Show currently running session\n"
"    minios-session info                           Show filesystem compatibility info\n"
"\n"
"  Session Management:\n"
"    minios-session activate 2                     Set session #2 as default for next boot\n"
"    minios-session delete 3                       Delete session #3 permanently\n"
"    minios-session cleanup --days 30              Delete sessions older than 30 days\n"
"    minios-session cleanup                        Delete sessions older than 30 days (default)\n"
"\n"
"  Creating Sessions:\n"
"    minios-session create                         Create native session (filesystem changes)\n"
"    minios-session create native                  Create native session explicitly\n"
"    minios-session create dynfilefs               Create 4000MB dynfilefs session (default size)\n"
"    minios-session create dynfilefs 8000          Create 8000MB dynfilefs session\n"
"    minios-session create raw 2000                Create 2000MB raw disk image\n"
"\n"
"  Session Operations:\n"
"    minios-session resize 2 4000                  Resize session #2 to 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Export session #3 to archive\n"
"    minios-session import /tmp/backup.tar.zst     Import session from archive\n"
"    minios-session copy 2                         Copy session #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Copy session #2 as raw with 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Convert session #3 to dynfilefs with 2000MB\n"
"\n"
"  Error Handling:\n"
"    minios-session create                         May fail on FAT32/NTFS/exFAT: \"Use dynfilefs or raw mode\"\n"
"    minios-session create raw 5000                Will fail on FAT32: MiniOS limits fixed containers to 4000MB\n"
"\n"
"  JSON Output (for automation):\n"
"    minios-session --json list                    List sessions in JSON format\n"
"    minios-session active --json                  Get active session info as JSON\n"
"    minios-session info --json                    Get system info as JSON\n"
"\n"
"  Custom Session Directory:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "
msgstr ""
"\n"
"GLOBALE OPTIONEN:\n"
"  --json                    Gibt Ergebnisse im JSON-Format aus (mit jedem Befehl nutzbar)\n"
"  --sessions-dir PFAD       Eigenes Sitzungsverzeichnis statt Standard verwenden\n"
"\n"
"BEFEHLE:\n"
"  list                      Listet alle verfügbaren Sitzungen mit Detailinformationen auf\n"
"  active                    Zeigt die aktuell aktive Sitzung (wird beim nächsten Start verwendet)\n"
"  running                   Zeigt die aktuell laufende Sitzung (aktueller Start)\n"
"  info                      Zeigt Dateisystemtyp und kompatible Sitzungsmodi\n"
"  activate SESSION_ID       Aktiviert die angegebene Sitzung\n"
"  create [MODE] [SIZE]      Erstellt eine neue Sitzung mit Positionsargumenten\n"
"  delete SESSION_ID         Löscht die angegebene Sitzung\n"
"  cleanup [--days N]        Löscht alte Sitzungen (Standard: 30 Tage)\n"
"  status                    Prüft Status und Berechtigungen des Sitzungsverzeichnisses\n"
"  resize SESSION_ID SIZE    Vergrößert eine Containersitzung\n"
"  export SESSION_ID PFAD    Exportiert Sitzung als .tar.zst-Archiv\n"
"  import ARCHIV             Importiert Sitzung aus .tar.zst-Archiv\n"
"  copy SESSION_ID           Kopiert Sitzung (optional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Konvertiert Sitzung in anderen Modus (optional: --size)\n"
"\n"
"SITZUNGSMODI:\n"
"  native                    Direkte Änderungen am Dateisystem (benötigt POSIX-kompatibles Dateisystem)\n"
"  dynfilefs                 Dynamisches Dateisystem-Overlay (funktioniert auf jedem Dateisystem)\n"
"  raw                       Rohes Disk-Image (funktioniert auf jedem Dateisystem, Standard: 4000MB)\n"
"\n"
"BEFEHLSVERHALTEN:\n"
"  • create ohne MODE: Verwendet nativen Modus (kann auf FAT32/NTFS/exFAT fehlschlagen)\n"
"  • create ohne SIZE: Verwendet 4000MB für Containermodi\n"
"  • convert ersetzt standardmäßig die Quelle; --new-session behält sie bei\n"
"  • cleanup ohne --days: Verwendet 30-Tage-Grenze für Löschung\n"
"  • cleanup schützt aktive und laufende Sitzungen vor Löschung\n"
"\n"
"BEISPIELE:\n"
"\n"
"  Grundlegende Nutzung:\n"
"    minios-session list                           Listet alle verfügbaren Sitzungen auf\n"
"    minios-session active                         Zeigt, welche Sitzung als nächstes gestartet wird\n"
"    minios-session running                        Zeigt aktuell laufende Sitzung\n"
"    minios-session info                           Zeigt Kompatibilitätsinfo zum Dateisystem\n"
"\n"
"  Sitzungsverwaltung:\n"
"    minios-session activate 2                     Setzt Sitzung #2 als Standard für nächsten Start\n"
"    minios-session delete 3                       Löscht Sitzung #3 dauerhaft\n"
"    minios-session cleanup --days 30              Löscht Sitzungen, die älter als 30 Tage sind\n"
"    minios-session cleanup                        Löscht Sitzungen, die älter als 30 Tage sind (Standard)\n"
"\n"
"  Sitzungen erstellen:\n"
"    minios-session create                         Erstellt native Sitzung (Dateisystemänderungen)\n"
"    minios-session create native                  Erstellt explizit native Sitzung\n"
"    minios-session create dynfilefs               Erstellt dynfilefs-Sitzung mit 4000MB (Standardgröße)\n"
"    minios-session create dynfilefs 8000          Erstellt dynfilefs-Sitzung mit 8000MB\n"
"    minios-session create raw 2000                Erstellt rohes Disk-Image mit 2000MB\n"
"\n"
"  Sitzungsoperationen:\n"
"    minios-session resize 2 4000                  Vergrößert Sitzung #2 auf 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Exportiert Sitzung #3 als Archiv\n"
"    minios-session import /tmp/backup.tar.zst     Importiert Sitzung aus Archiv\n"
"    minios-session copy 2                         Kopiert Sitzung #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Kopiert Sitzung #2 als raw mit 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Konvertiert Sitzung #3 zu dynfilefs mit 2000MB\n"
"\n"
"  Fehlerbehandlung:\n"
"    minios-session create                         Kann auf FAT32/NTFS/exFAT fehlschlagen: \"dynfilefs oder raw-Modus verwenden\"\n"
"    minios-session create raw 5000                Schlägt auf FAT32 fehl: MiniOS begrenzt feste Container auf 4000MB\n"
"\n"
"  JSON-Ausgabe (für Automatisierung):\n"
"    minios-session --json list                    Listet Sitzungen im JSON-Format auf\n"
"    minios-session active --json                  Zeigt aktive Sitzung als JSON\n"
"    minios-session info --json                    Zeigt Systeminfo als JSON\n"
"\n"
"  Eigenes Sitzungsverzeichnis:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "

