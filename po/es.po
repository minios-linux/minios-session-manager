#: lib/minios_session.py:2884
msgid "MiniOS Session Manager - Command line tool for managing persistent sessions"
msgstr "MiniOS Session Manager - Herramienta de línea de comandos para gestionar sesiones persistentes"

#: lib/minios_session.py:2886
msgid ""
"\n"
"GLOBAL OPTIONS:\n"
"  --json                    Output results in JSON format (can be used with any command)\n"
"  --sessions-dir PATH       Use custom sessions directory instead of default\n"
"\n"
"COMMANDS:\n"
"  list                      List all available sessions with detailed information\n"
"  active                    Show currently active session (will boot next)\n"
"  running                   Show currently running session (current boot)\n"
"  info                      Show filesystem type and compatible session modes\n"
"  activate SESSION_ID       Activate specified session\n"
"  create [MODE] [SIZE]      Create new session using positional arguments\n"
"  delete SESSION_ID         Delete specified session\n"
"  cleanup [--days N]        Delete old sessions (default: 30 days)\n"
"  status                    Check sessions directory status and permissions\n"
"  resize SESSION_ID SIZE    Grow a container session\n"
"  export SESSION_ID PATH    Export session to .tar.zst archive\n"
"  import ARCHIVE            Import session from .tar.zst archive\n"
"  copy SESSION_ID           Copy session (optional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Convert session to different mode (optional: --size)\n"
"\n"
"SESSION MODES:\n"
"  native                    Direct filesystem changes (requires POSIX-compatible filesystem)\n"
"  dynfilefs                 Dynamic file system overlay (works on any filesystem)\n"
"  raw                       Raw disk image (works on any filesystem, 4000MB default)\n"
"\n"
"COMMAND BEHAVIOR:\n"
"  • create without MODE: Uses native mode (may fail on FAT32/NTFS/exFAT)\n"
"  • create without SIZE: Uses 4000MB for container modes\n"
"  • convert replaces the source by default; --new-session preserves it\n"
"  • cleanup without --days: Uses 30-day threshold for deletion\n"
"  • cleanup protects both active and running sessions from deletion\n"
"\n"
"EXAMPLES:\n"
"\n"
"  Basic Usage:\n"
"    minios-session list                           List all available sessions\n"
"    minios-session active                         Show which session will boot next\n"
"    minios-session running                        Show currently running session\n"
"    minios-session info                           Show filesystem compatibility info\n"
"\n"
"  Session Management:\n"
"    minios-session activate 2                     Set session #2 as default for next boot\n"
"    minios-session delete 3                       Delete session #3 permanently\n"
"    minios-session cleanup --days 30              Delete sessions older than 30 days\n"
"    minios-session cleanup                        Delete sessions older than 30 days (default)\n"
"\n"
"  Creating Sessions:\n"
"    minios-session create                         Create native session (filesystem changes)\n"
"    minios-session create native                  Create native session explicitly\n"
"    minios-session create dynfilefs               Create 4000MB dynfilefs session (default size)\n"
"    minios-session create dynfilefs 8000          Create 8000MB dynfilefs session\n"
"    minios-session create raw 2000                Create 2000MB raw disk image\n"
"\n"
"  Session Operations:\n"
"    minios-session resize 2 4000                  Resize session #2 to 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Export session #3 to archive\n"
"    minios-session import /tmp/backup.tar.zst     Import session from archive\n"
"    minios-session copy 2                         Copy session #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Copy session #2 as raw with 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Convert session #3 to dynfilefs with 2000MB\n"
"\n"
"  Error Handling:\n"
"    minios-session create                         May fail on FAT32/NTFS/exFAT: \"Use dynfilefs or raw mode\"\n"
"    minios-session create raw 5000                Will fail on FAT32: MiniOS limits fixed containers to 4000MB\n"
"\n"
"  JSON Output (for automation):\n"
"    minios-session --json list                    List sessions in JSON format\n"
"    minios-session active --json                  Get active session info as JSON\n"
"    minios-session info --json                    Get system info as JSON\n"
"\n"
"  Custom Session Directory:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "
msgstr ""
"\n"
"OPCIONES GLOBALES:\n"
"  --json                    Muestra los resultados en formato JSON (puede usarse con cualquier comando)\n"
"  --sessions-dir RUTA       Usa un directorio de sesiones personalizado en lugar del predeterminado\n"
"\n"
"COMANDOS:\n"
"  list                      Lista todas las sesiones disponibles con información detallada\n"
"  active                    Muestra la sesión activa actualmente (se iniciará en el próximo arranque)\n"
"  running                   Muestra la sesión que está en ejecución (arranque actual)\n"
"  info                      Muestra el tipo de sistema de archivos y los modos de sesión compatibles\n"
"  activate SESSION_ID       Activa la sesión especificada\n"
"  create [MODE] [SIZE]      Crea una nueva sesión usando argumentos posicionales\n"
"  delete SESSION_ID         Elimina la sesión especificada\n"
"  cleanup [--days N]        Elimina sesiones antiguas (por defecto: 30 días)\n"
"  status                    Verifica el estado y permisos del directorio de sesiones\n"
"  resize SESSION_ID SIZE    Amplía el tamaño de una sesión contenedor\n"
"  export SESSION_ID PATH    Exporta la sesión a un archivo .tar.zst\n"
"  import ARCHIVE            Importa una sesión desde un archivo .tar.zst\n"
"  copy SESSION_ID           Copia una sesión (opcional: --to-mode, --size)\n"
"  convert SESSION_ID MODE   Convierte la sesión a otro modo (opcional: --size)\n"
"\n"
"MODOS DE SESIÓN:\n"
"  native                    Cambios directos en el sistema de archivos (requiere sistema de archivos compatible con POSIX)\n"
"  dynfilefs                 Overlay de sistema de archivos dinámico (funciona en cualquier sistema de archivos)\n"
"  raw                       Imagen de disco sin procesar (funciona en cualquier sistema de archivos, 4000MB por defecto)\n"
"\n"
"COMPORTAMIENTO DE LOS COMANDOS:\n"
"  • create sin MODE: Usa modo nativo (puede fallar en FAT32/NTFS/exFAT)\n"
"  • create sin SIZE: Usa 4000MB para modos contenedor\n"
"  • convert reemplaza la sesión original por defecto; --new-session la conserva\n"
"  • cleanup sin --days: Usa un umbral de 30 días para eliminación\n"
"  • cleanup protege tanto la sesión activa como la que está en ejecución de ser eliminadas\n"
"\n"
"EJEMPLOS:\n"
"\n"
"  Uso Básico:\n"
"    minios-session list                           Lista todas las sesiones disponibles\n"
"    minios-session active                         Muestra qué sesión se iniciará en el próximo arranque\n"
"    minios-session running                        Muestra la sesión que está en ejecución\n"
"    minios-session info                           Muestra información de compatibilidad del sistema de archivos\n"
"\n"
"  Gestión de Sesiones:\n"
"    minios-session activate 2                     Establece la sesión #2 como predeterminada para el próximo arranque\n"
"    minios-session delete 3                       Elimina permanentemente la sesión #3\n"
"    minios-session cleanup --days 30              Elimina sesiones con más de 30 días\n"
"    minios-session cleanup                        Elimina sesiones con más de 30 días (por defecto)\n"
"\n"
"  Creación de Sesiones:\n"
"    minios-session create                         Crea sesión nativa (cambios en sistema de archivos)\n"
"    minios-session create native                  Crea sesión nativa explícitamente\n"
"    minios-session create dynfilefs               Crea sesión dynfilefs de 4000MB (tamaño por defecto)\n"
"    minios-session create dynfilefs 8000          Crea sesión dynfilefs de 8000MB\n"
"    minios-session create raw 2000                Crea imagen de disco raw de 2000MB\n"
"\n"
"  Operaciones con Sesiones:\n"
"    minios-session resize 2 4000                  Redimensiona la sesión #2 a 4000MB\n"
"    minios-session export 3 /tmp/backup.tar.zst   Exporta la sesión #3 a un archivo\n"
"    minios-session import /tmp/backup.tar.zst     Importa una sesión desde un archivo\n"
"    minios-session copy 2                         Copia la sesión #2\n"
"    minios-session copy 2 --to-mode raw --size 3000  Copia la sesión #2 como raw con 3000MB\n"
"    minios-session convert 3 dynfilefs --size 2000   Convierte la sesión #3 a dynfilefs con 2000MB\n"
"\n"
"  Manejo de Errores:\n"
"    minios-session create                         Puede fallar en FAT32/NTFS/exFAT: \"Usa modo dynfilefs o raw\"\n"
"    minios-session create raw 5000                Fallará en FAT32: MiniOS limita los contenedores fijos a 4000MB\n"
"\n"
"  Salida en JSON (para automatización):\n"
"    minios-session --json list                    Lista sesiones en formato JSON\n"
"    minios-session active --json                  Obtiene información de la sesión activa en JSON\n"
"    minios-session info --json                    Obtiene información del sistema en JSON\n"
"\n"
"  Directorio de Sesiones Personalizado:\n"
"    minios-session --sessions-dir /mnt/usb/sessions list\n"
"    minios-session --sessions-dir /tmp/test create native\n"
"\n"
"        "

