msgid "session;persistent;changes;storage;"
msgstr "session;persistant;modifications;stockage;"

#~ msgid ""
#~ "\n"
#~ "GLOBAL OPTIONS:\n"
#~ "  --json                    Output results in JSON format (can be used with any command)\n"
#~ "  --sessions-dir PATH       Use custom sessions directory instead of default\n"
#~ "\n"
#~ "COMMANDS:\n"
#~ "  list                      List all available sessions with detailed information\n"
#~ "  active                    Show currently active session (will boot next)\n"
#~ "  running                   Show currently running session (current boot)\n"
#~ "  info                      Show filesystem type and compatible session modes\n"
#~ "  activate SESSION_ID       Activate specified session\n"
#~ "  create [MODE] [SIZE]      Create new session using positional arguments\n"
#~ "  delete SESSION_ID         Delete specified session\n"
#~ "  cleanup [--days N]        Delete old sessions (default: 30 days)\n"
#~ "  status                    Check sessions directory status and permissions\n"
#~ "  resize SESSION_ID SIZE    Resize session to a larger size (dynfilefs/raw/luks)\n"
#~ "  export SESSION_ID PATH    Export session to .tar.zst archive\n"
#~ "  import ARCHIVE            Import session from .tar.zst archive\n"
#~ "  copy SESSION_ID           Copy session (optional: --to-mode, --size)\n"
#~ "  convert SESSION_ID MODE   Convert session to different mode (optional: --size)\n"
#~ "\n"
#~ "SESSION MODES:\n"
#~ "  native                    Direct filesystem changes (requires POSIX-compatible filesystem)\n"
#~ "  dynfilefs                 Dynamic file system overlay (works on any filesystem)\n"
#~ "  raw                       Raw disk image (works on any filesystem, 4000MB default)\n"
#~ "  luks                      LUKS2-encrypted ext4 file (requires a LUKS-capable initrd)\n"
#~ "\n"
#~ "COMMAND BEHAVIOR:\n"
#~ "  • create without MODE: Uses native mode (may fail on FAT32/NTFS/exFAT)\n"
#~ "  • create without SIZE: Uses 4000MB for dynfilefs/raw/luks modes\n"
#~ "  • convert replaces the source by default; --new-session preserves it\n"
#~ "  • cleanup without --days: Uses 30-day threshold for deletion\n"
#~ "  • cleanup protects both active and running sessions from deletion\n"
#~ "\n"
#~ "EXAMPLES:\n"
#~ "\n"
#~ "  Basic Usage:\n"
#~ "    minios-session list                           List all available sessions\n"
#~ "    minios-session active                         Show which session will boot next\n"
#~ "    minios-session running                        Show currently running session\n"
#~ "    minios-session info                           Show filesystem compatibility info\n"
#~ "\n"
#~ "  Session Management:\n"
#~ "    minios-session activate 2                     Set session #2 as default for next boot\n"
#~ "    minios-session delete 3                       Delete session #3 permanently\n"
#~ "    minios-session cleanup --days 30              Delete sessions older than 30 days\n"
#~ "    minios-session cleanup                        Delete sessions older than 30 days (default)\n"
#~ "\n"
#~ "  Creating Sessions:\n"
#~ "    minios-session create                         Create native session (filesystem changes)\n"
#~ "    minios-session create native                  Create native session explicitly\n"
#~ "    minios-session create dynfilefs               Create 4000MB dynfilefs session (default size)\n"
#~ "    minios-session create dynfilefs 8000          Create 8000MB dynfilefs session\n"
#~ "    minios-session create raw 2000                Create 2000MB raw disk image\n"
#~ "    minios-session create luks 4GB --password-stdin  Create encrypted LUKS session\n"
#~ "\n"
#~ "  Session Operations:\n"
#~ "    minios-session resize 2 4000                  Resize session #2 to 4000MB\n"
#~ "    minios-session export 3 /tmp/backup.tar.zst   Export session #3 to archive\n"
#~ "    minios-session import /tmp/backup.tar.zst     Import session from archive\n"
#~ "    minios-session copy 2                         Copy session #2\n"
#~ "    minios-session copy 2 --to-mode raw --size 3000  Copy session #2 as raw with 3000MB\n"
#~ "    minios-session convert 3 dynfilefs --size 2000   Convert session #3 to dynfilefs with 2000MB\n"
#~ "\n"
#~ "  Error Handling:\n"
#~ "    minios-session create                         May fail on FAT32/NTFS/exFAT: \"Use dynfilefs or raw mode\"\n"
#~ "    minios-session create raw 5000                Will fail on FAT32: MiniOS limits fixed containers to 4000MB\n"
#~ "\n"
#~ "  JSON Output (for automation):\n"
#~ "    minios-session --json list                    List sessions in JSON format\n"
#~ "    minios-session active --json                  Get active session info as JSON\n"
#~ "    minios-session info --json                    Get system info as JSON\n"
#~ "\n"
#~ "  Custom Session Directory:\n"
#~ "    minios-session --sessions-dir /mnt/usb/sessions list\n"
#~ "    minios-session --sessions-dir /tmp/test create native\n"
#~ "\n"
#~ "        "
#~ msgstr ""
#~ "\n"
#~ "OPTIONS GÉNÉRALES :\n"
#~ "  --json                    Affiche les résultats au format JSON (utilisable avec n'importe quelle commande)\n"
#~ "  --sessions-dir CHEMIN     Utilise un dossier de sessions personnalisé au lieu du dossier par défaut\n"
#~ "\n"
#~ "COMMANDES :\n"
#~ "  list                      Liste toutes les sessions disponibles avec des informations détaillées\n"
#~ "  active                    Affiche la session actuellement active (sera démarrée au prochain boot)\n"
#~ "  running                   Affiche la session en cours d'exécution (boot actuel)\n"
#~ "  info                      Affiche le type de système de fichiers et les modes de session compatibles\n"
#~ "  activate SESSION_ID       Active la session spécifiée\n"
#~ "  create [MODE] [TAILLE]    Crée une nouvelle session avec les arguments positionnels\n"
#~ "  delete SESSION_ID         Supprime la session spécifiée\n"
#~ "  cleanup [--days N]        Supprime les anciennes sessions (par défaut : 30 jours)\n"
#~ "  status                    Vérifie l'état et les permissions du dossier de sessions\n"
#~ "  resize SESSION_ID TAILLE  Redimensionne la session vers une taille supérieure (dynfilefs/raw/luks)\n"
#~ "  export SESSION_ID CHEMIN  Exporte la session vers une archive .tar.zst\n"
#~ "  import ARCHIVE            Importe une session depuis une archive .tar.zst\n"
#~ "  copy SESSION_ID           Copie la session (optionnel : --to-mode, --size)\n"
#~ "  convert SESSION_ID MODE   Convertit la session dans un autre mode (optionnel : --size)\n"
#~ "\n"
#~ "MODES DE SESSION :\n"
#~ "  native                    Modifications directes du système de fichiers (nécessite un système de fichiers compatible POSIX)\n"
#~ "  dynfilefs                 Overlay dynamique de fichiers (fonctionne sur tout système de fichiers)\n"
#~ "  raw                       Image disque brute (fonctionne sur tout système de fichiers, 4000 Mo par défaut)\n"
#~ "  luks                      Fichier ext4 chiffré LUKS2 (nécessite un initrd compatible LUKS)\n"
#~ "\n"
#~ "COMPORTEMENT DES COMMANDES :\n"
#~ "  • create sans MODE : Utilise le mode natif (peut échouer sur FAT32/NTFS/exFAT)\n"
#~ "  • create sans TAILLE : Utilise 4000 Mo pour les modes dynfilefs/raw/luks\n"
#~ "  • convert remplace la source par défaut ; --new-session la préserve\n"
#~ "  • cleanup sans --days : Utilise un seuil de suppression de 30 jours\n"
#~ "  • cleanup protège les sessions actives et en cours d'exécution contre la suppression\n"
#~ "\n"
#~ "EXEMPLES :\n"
#~ "\n"
#~ "  Utilisation de base :\n"
#~ "    minios-session list                           Liste toutes les sessions disponibles\n"
#~ "    minios-session active                         Affiche la session qui démarrera au prochain boot\n"
#~ "    minios-session running                        Affiche la session actuellement en cours\n"
#~ "    minios-session info                           Affiche les informations de compatibilité du système de fichiers\n"
#~ "\n"
#~ "  Gestion des sessions :\n"
#~ "    minios-session activate 2                     Définit la session n°2 comme session par défaut au prochain démarrage\n"
#~ "    minios-session delete 3                       Supprime définitivement la session n°3\n"
#~ "    minios-session cleanup --days 30              Supprime les sessions de plus de 30 jours\n"
#~ "    minios-session cleanup                        Supprime les sessions de plus de 30 jours (par défaut)\n"
#~ "\n"
#~ "  Création de sessions :\n"
#~ "    minios-session create                         Crée une session native (modifications du système de fichiers)\n"
#~ "    minios-session create native                  Crée explicitement une session native\n"
#~ "    minios-session create dynfilefs               Crée une session dynfilefs de 4000 Mo (taille par défaut)\n"
#~ "    minios-session create dynfilefs 8000          Crée une session dynfilefs de 8000 Mo\n"
#~ "    minios-session create raw 2000                Crée une image disque brute de 2000 Mo\n"
#~ "    minios-session create luks 4GB --password-stdin  Crée une session LUKS chiffrée\n"
#~ "\n"
#~ "  Opérations sur les sessions :\n"
#~ "    minios-session resize 2 4000                  Redimensionne la session n°2 à 4000 Mo\n"
#~ "    minios-session export 3 /tmp/backup.tar.zst   Exporte la session n°3 vers une archive\n"
#~ "    minios-session import /tmp/backup.tar.zst     Importe une session depuis une archive\n"
#~ "    minios-session copy 2                         Copie la session n°2\n"
#~ "    minios-session copy 2 --to-mode raw --size 3000  Copie la session n°2 en mode raw avec 3000 Mo\n"
#~ "    minios-session convert 3 dynfilefs --size 2000   Convertit la session n°3 en dynfilefs avec 2000 Mo\n"
#~ "\n"
#~ "  Gestion des erreurs :\n"
#~ "    minios-session create                         Peut échouer sur FAT32/NTFS/exFAT : \"Utilisez le mode dynfilefs ou raw\"\n"
#~ "    minios-session create raw 5000                Échouera sur FAT32 : MiniOS limite les conteneurs fixes à 4000 Mo\n"
#~ "\n"
#~ "  Sortie JSON (pour automatisation) :\n"
#~ "    minios-session --json list                    Liste les sessions au format JSON\n"
#~ "    minios-session active --json                  Affiche les infos de la session active en JSON\n"
#~ "    minios-session info --json                    Affiche les infos système en JSON\n"
#~ "\n"
#~ "  Dossier de sessions personnalisé :\n"
#~ "    minios-session --sessions-dir /mnt/usb/sessions list\n"
#~ "    minios-session --sessions-dir /tmp/test create native\n"
#~ "\n"
#~ "        "

