#~ "\n"
#~ "ПОВЕДЕНИЕ КОМАНД:\n"
#~ "  • create без MODE: используется native (может не работать на FAT32/NTFS/exFAT)\n"
#~ "  • create без SIZE: используется 4000 МБ для dynfilefs/raw/luks\n"
#~ "  • convert по умолчанию заменяет исходную сессию; --new-session сохраняет её\n"
#~ "  • cleanup без --days: используется порог 30 дней для удаления\n"
#~ "  • cleanup защищает активные и запущенные сессии от удаления\n"
#~ "\n"
#~ "ПРИМЕРЫ:\n"
#~ "\n"
#~ "  Базовое использование:\n"
#~ "    minios-session list                           Показать все доступные сессии\n"
#~ "    minios-session active                         Показать, какая сессия будет загружена следующей\n"
#~ "    minios-session running                        Показать текущую запущенную сессию\n"
#~ "    minios-session info                           Показать информацию о совместимости файловых систем\n"
#~ "\n"
#~ "  Управление сессиями:\n"
#~ "    minios-session activate 2                     Установить сессию №2 как основную для следующей загрузки\n"
#~ "    minios-session delete 3                       Безвозвратно удалить сессию №3\n"
#~ "    minios-session cleanup --days 30              Удалить сессии старше 30 дней\n"
#~ "    minios-session cleanup                        Удалить сессии старше 30 дней (по умолчанию)\n"
#~ "\n"
#~ "  Создание сессий:\n"
#~ "    minios-session create                         Создать native-сессию (изменения в ФС)\n"
#~ "    minios-session create native                  Явно создать native-сессию\n"
#~ "    minios-session create dynfilefs               Создать dynfilefs-сессию 4000 МБ (размер по умолчанию)\n"
#~ "    minios-session create dynfilefs 8000          Создать dynfilefs-сессию 8000 МБ\n"
#~ "    minios-session create raw 2000                Создать raw-образ 2000 МБ\n"
#~ "    minios-session create luks 4GB --password-stdin  Создать зашифрованную LUKS-сессию\n"
#~ "\n"
#~ "  Операции с сессиями:\n"
#~ "    minios-session resize 2 4000                  Изменить размер сессии №2 до 4000 МБ\n"
#~ "    minios-session export 3 /tmp/backup.tar.zst   Экспортировать сессию №3 в архив\n"
