#!/bin/sh
#
# MiniOS Persistence Guard launcher (root daemon).
# Monitors the backing storage and inner persistence filesystem and publishes
# state to /run/minios-persistence/state for the desktop notifier.
#

set -e

SCRIPT_DIR=$(dirname "$(readlink -f -- "$0")")

if [ -f "/usr/lib/minios-session-manager/minios_persistence_guard.py" ]; then
    DIR="/usr/lib/minios-session-manager"
else
    DIR="$(dirname "$SCRIPT_DIR")/lib"
fi

exec python3 -u "$DIR/minios_persistence_guard.py" "$@"
