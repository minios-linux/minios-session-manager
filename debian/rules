#!/usr/bin/make -f

%:
	dh $@

override_dh_installinit:
	dh_installinit -pminios-session --name=minios-persistence-guard --only-scripts
	dh_installinit -pminios-session --name=minios-session-autosave --only-scripts

override_dh_auto_test:
	python3 -m pytest -q

override_dh_install:
	dh_install
	python3 tests/check_installed_backend.py debian/minios-session

override_dh_missing:
	dh_missing --fail-missing
